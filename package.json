{
  "name": "safe-support",
  "private": true,
  "version": "0.1.0",
  "description": "平安托付 - 状态申请与家属邮件提醒",
  "author": "平安托付",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable --x64",
    "dist:win:nsis": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.safesupport.pingantuofu",
    "productName": "平安托付",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "PingAnTuoFu-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PingAnTuoFu-${version}-setup.${ext}"
    }
  }
}
